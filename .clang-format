BasedOnStyle: LLVM  # Or LLVM, Microsoft, Mozilla, WebKit, etc.
BraceWrapping: false
IndentWidth: 4        # Use 4 spaces per indentation level
UseTab: Never         # Use spaces instead of tabs
ColumnLimit: 120      # Maximum line width before wrapping
BreakBeforeBraces: Attach # Attach `{` to the function/class declaration
AllowShortFunctionsOnASingleLine: Empty # Allow empty functions on one line
SortIncludes: true    # Automatically sort #include directives
AlignConsecutiveAssignments: true # Align `=` in variable declarations
PointerAlignment: Left # `int* ptr` instead of `int *ptr`
Standard: C++17       # Set the C++ standard (C++11, C++14, C++17, C++20)
